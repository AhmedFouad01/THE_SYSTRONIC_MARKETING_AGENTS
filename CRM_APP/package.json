{
	"name": "systronic-crm-m0",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.18.0"
	},
	"scripts": {
		"api": "tsx --env-file=.env src/api.ts",
		"worker": "tsx --env-file=.env src/worker.ts",
		"migrate": "tsx --env-file=.env scripts/migrate.ts",
		"seed": "tsx --env-file=.env scripts/seed.ts",
		"lint": "biome lint src scripts tests",
		"typecheck": "tsc --noEmit",
		"build": "tsc && tsx scripts/build-assets.ts",
		"test:db": "tsx --env-file=.env --test tests/foundation.test.ts",
		"test:ui": "playwright test",
		"test": "npm run test:db && npm run test:ui"
	},
	"dependencies": {
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.63.0",
		"@types/node": "24.19.0",
		"@types/pg": "8.23.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	}
}
